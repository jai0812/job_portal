# Copy this file to .env and fill in what you have. Anything left blank falls back to
# "manual mode": the portal gives you the prompt to paste into chatgpt.com / claude.ai.
#
# NOTE: ChatGPT Plus and Claude Pro are chat subscriptions and do NOT include API access.
# API keys are separate, pay-as-you-go: https://platform.openai.com/api-keys and
# https://console.anthropic.com/settings/keys  (Ask All LLMs is billed per message).

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional extra LLMs for the side-by-side "Ask All" tab (OpenAI-compatible APIs)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Apify token for LinkedIn scraping: https://console.apify.com/settings/integrations
APIFY_TOKEN=

PORT=8787

# ---- Only for running the portal online (see DEPLOY.md) ----
# Set the password with:  .venv/bin/python scripts/set_password.py   (it fills in the next two lines for you)
# PORTAL_PASSWORD_HASH=
# SESSION_SECRET=
# PORTAL_TOTP_SECRET=        # added by  set_password.py --2fa
# PORTAL_HOST=0.0.0.0               # listen for other computers; the portal refuses to start like this without a password
# TRUST_PROXY=1              # when it sits behind Caddy / Cloudflare / a hosting platform (they provide https)
